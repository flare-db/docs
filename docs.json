{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "FlareDB",
  "favicon": "/flare-mascot-face.svg",
  "colors": {
    "primary": "#E9692C",
    "light": "#E9692C",
    "dark": "#E9692C"
  },
  "background": {
    "light": "#FFFFFF",
    "dark": "#0d0d0f",
    "decoration": "gradient"
  },
  "navigation": {
    "pages": [
      {
        "group": "Intoduction",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "usage",
          "io",
          "sql",
          "cli",
          "compatibility",
          "python",
          "agent-skills"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/flare-db/flare-db",
          "icon": "github"
        },
        {
          "anchor": "Blog",
          "href": "https://www.flare-db.com/blog",
          "icon": "newspaper"
        },
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://discord.gg/uRphm5uJ8"
        }
      ]
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Support",
      "href": "https://github.com/flare-db/flare-db/issues"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "toc"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/flare-db/flare-db",
      "linkedin": "https://www.linkedin.com/company/flare-db/"
    }
  },
  "description": "FlareDB is an Apache Beam native streaming database for running batch and streaming data pipelines",
  "icons": {
    "library": "fontawesome"
  },
  "seo": {
    "metatags": {
      "og:site_name": "FlareDB"
    },
    "indexing": "all"
  },
  "interaction": {
    "drilldown": false
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "section"
  }
